#!/bin/sh /etc/rc.common
# =====================================================================
# EMS-Watchdog Init-Skript fuer RUTOS (OpenWrt rc.common)
# Installation: /etc/init.d/ems_watchdog enable && /etc/init.d/ems_watchdog start
# Hinweis: spaeter ggf. auf procd umstellen (USE_PROCD=1)
# =====================================================================

START=95
STOP=10

PIDFILE=/var/run/ems_watchdog.pid

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
        echo "ems_watchdog laeuft bereits (PID $(cat $PIDFILE))"
        return 0
    fi
    /usr/bin/ems_watchdog.sh &
    echo $! > "$PIDFILE"
    echo "ems_watchdog gestartet (PID $(cat $PIDFILE))"
}

stop() {
    # PID-basiert stoppen (kein killall, siehe docs/Learnings.md)
    if [ -f "$PIDFILE" ]; then
        kill "$(cat $PIDFILE)" 2>/dev/null
        rm -f "$PIDFILE"
        echo "ems_watchdog gestoppt"
    else
        echo "ems_watchdog: kein PID-File gefunden"
    fi
}

restart() {
    stop
    sleep 1
    start
}
